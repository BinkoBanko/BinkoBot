modules = ["python-3.11"]
run = "RUN_MODE=both python3 main.py"
entrypoint = "main.py"

[env]
REPLIT = "1"

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "RUN_MODE=both python3 main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "vm"
run = ["python3", "main.py"]
